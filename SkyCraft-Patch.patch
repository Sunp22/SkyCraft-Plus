+		// Copies the models of what is around the player (a crate first) into Data/Meshes/SkyCraft/vanilla_dump, to be looked at.
+		void DumpVanillaModels(RE::PlayerCharacter* a_player)
+		{
+			static bool dumped = false;
+			if (dumped) {
+				return;
+			}
+			dumped = true;
+			const std::filesystem::path dir = kDir.parent_path() / "vanilla_dump";
+			std::error_code             ec;
+			std::filesystem::create_directories(dir, ec);
+
+			std::vector<std::string> paths;
+			auto                     add = [&](const char* a_model) {
+                if (!a_model || !*a_model || paths.size() >= 40) {
+                    return;
+                }
+                std::string m = a_model;
+                std::string lower = m;
+                std::ranges::transform(lower, lower.begin(), [](unsigned char ch) { return static_cast<char>(std::tolower(ch)); });
+                if (lower.find("skycraft") != std::string::npos || lower.find(".nif") == std::string::npos) {
+                    return;
+                }
+                for (const auto& have : paths) {
+                    std::string h = have;
+                    std::ranges::transform(h, h.begin(), [](unsigned char ch) { return static_cast<char>(std::tolower(ch)); });
+                    if (h == lower) {
+                        return;
+                    }
+                }
+                paths.push_back(m);
+			};
+			if (auto* crate = RE::TESForm::LookupByID(0x0007A617)) {
+				if (auto* model = skyrim_cast<RE::TESModel*>(crate)) {
+					add(model->GetModel());
+				}
+			}
+			if (auto* cell = a_player->GetParentCell()) {
+				cell->ForEachReference([&](auto&& a_ref) {
+					auto* ref = AsRef(a_ref);
+					auto* base = ref ? ref->GetBaseObject() : nullptr;
+					auto* model = base ? skyrim_cast<RE::TESModel*>(base) : nullptr;
+					if (model) {
+						add(model->GetModel());
+					}
+					return paths.size() >= 40 ? RE::BSContainer::ForEachResult::kStop : RE::BSContainer::ForEachResult::kContinue;
+				});
+			}
+
+			int copied = 0;
+			for (const auto& path : paths) {
+				std::vector<std::uint8_t> bytes;
+				if (!ReadNif(std::string("Meshes\\") + path, bytes) || bytes.size() > 400000) {
+					continue;
+				}
+				std::string name = path;
+				for (auto& ch : name) {
+					if (ch == '\\' || ch == '/' || ch == ':') {
+						ch = '_';
+					}
+				}
+				std::ofstream out(dir / name, std::ios::binary | std::ios::trunc);
+				out.write(reinterpret_cast<const char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+				++copied;
+			}
+			logger::info("Block collision: copied {} of {} nearby vanilla models into {} (for looking at their collision layout)", copied, paths.size(), AbsolutePath(dir));
+		}
+
+		void StartVariants(RE::PlayerCharacter* a_player, RE::TESDataHandler* a_handler, const RE::NiPoint3& a_pos, std::uint32_t a_material)
+		{
+			variantsStarted = true;
+			variantsDone = false;
+			using O = collisionnif::Options;
+			struct Def
+			{
+				std::string label;
+				O           opts;
+				std::string fixedFile;  // a file made at plugin load and left as it was (else a slot, written now), or "new": a file made now under a new name
+				bool        usable{ false };
+			};
+			std::vector<Def> defs;
+			// Revision 32: only the models that can be right, tried ONE AT A TIME, smallest first (a bad collision model crashes Skyrim, so the
+			// last "LOADING" line in the log names the file that did it). The byte-shifted layouts that used to be tried alongside are gone.
+			{ O o; o.level = 0; defs.push_back({ "TEST 1: bare node, a file made at plugin load", o, "pre_bare.nif", false }); }
+			{ O o; o.level = 1; defs.push_back({ "TEST 2: node with BSXFlags, written over a slot just now", o, "", false }); }
+			{ O o; o.level = 2; defs.push_back({ "TEST 3: body with one box, a file made at plugin load", o, "pre_box.nif", false }); }
+			{ O o; defs.push_back({ "TEST 4: list of boxes, a file made at plugin load", o, "pre_full.nif", false }); }
+			defs.push_back({ "as written", O{}, "", true });
+			if (variantsSafe) {
+				std::erase_if(defs, [](const Def& d) { return d.opts.level >= 2; });  // nothing with collision in it
+			}
+			const float                          u = float(proto::kUnitsPerBlock);
+			const std::vector<collisionnif::Box> one{ collisionnif::Box{ { 0.0f, 0.0f, 0.0f }, { u, u, u } } };
+			logger::info("Block collision test: model files are in {}", AbsolutePath(kDir));
+			for (auto& d : defs) {
+				Variant v;
+				v.label = d.label;
+				v.opts = d.opts;
+				v.usable = d.usable;
+				const auto bytes = collisionnif::Build(one, a_material, 0.01f, d.opts);
+				if (!d.fixedFile.empty() && d.fixedFile != "new") {
+					v.file = d.fixedFile;  // as PrepareFiles left it
+				} else if (d.fixedFile == "new") {
+					v.file = fmt::format("rt{}.nif", ++serial);
+					if (!WriteFile(v.file, bytes)) {
+						v.file.clear();
+					}
+				} else {
+					v.file = TakeSlot();
+					if (!v.file.empty() && !WriteFile(v.file, bytes)) {
+						v.file.clear();
+					}
+				}
+				if (v.file.empty()) {
+					v.done = true;
+					variants.push_back(std::move(v));
+					continue;
+				}
+				variantPos = a_pos;  // its reference is made by TickVariants, when it is its turn
+				variants.push_back(std::move(v));
+			}
+			logger::info("Block collision test: {} variants of the model are in the world to see which Skyrim loads", variants.size());
+		}
+
+		// Puts one variant's model in the world. The line is logged first: if Skyrim crashes while loading it, it is the last line of the log.
+		void LaunchVariant(Variant& a_v)
+		{
+			a_v.launched = true;
+			logger::info("Block collision test: LOADING '{}' from {} (if Skyrim crashes now, this is the file that did it)", a_v.label, a_v.file);
+			spdlog::default_logger()->flush();
+			auto* player = RE::PlayerCharacter::GetSingleton();
+			auto* handler = RE::TESDataHandler::GetSingleton();
+			if (player && handler) {
+				if (auto* form = MakeStatic(std::string(kModelDir) + a_v.file, float(16 * proto::kUnitsPerBlock))) {
+					auto ref = handler->CreateReferenceAtLocation(form, variantPos, RE::NiPoint3(), player->GetParentCell(), player->GetWorldspace(), nullptr, nullptr, RE::ObjectRefHandle(), false, true).get();
+					if (ref) {
+						ref->SetActivationBlocked(true);
+						a_v.refId = ref->GetFormID();
+					}
+				}
+			}
+			if (a_v.refId == 0) {
+				a_v.done = true;
+				logger::info("Block collision test: could not make a reference for '{}'", a_v.label);
+			}
+		}
+
+		void TickVariants(float a_delta)
+		{
+			if (!variantsStarted || variantsDone) {
+				return;
+			}
+			Variant* current = nullptr;
+			for (auto& v : variants) {
+				if (!v.done) {
+					current = &v;  // one at a time: the next is not started until this one has loaded (or been given up on)
+					break;
+				}
+			}
+			if (current) {
+				auto& v = *current;
+				if (!v.launched) {
+					LaunchVariant(v);
+				} else {
+					v.waited += a_delta;
+					auto* ref = RE::TESForm::LookupByID<RE::TESObjectREFR>(v.refId);
+					auto* root = ref ? ref->Get3D() : nullptr;
+					if (ref && !root && !v.forced && v.waited > 1.5f) {
+						v.forced = true;
+						logger::info("Block collision test: asking Skyrim for the 3D of '{}'", v.label);
+						root = ref->Load3D(false);
+					}
+					if (root) {
+						bool hasObject = false, inWorld = false;
+						CollisionState(root, hasObject, inWorld);
+						v.done = v.ok = true;
+						logger::info("Block collision test: LOADED  '{}' (3D after {:.1f} s; collision object {}, in the Havok world {})", v.label, v.waited, hasObject ? "yes" : "no", inWorld ? "yes" : "not yet");
+					} else if (v.waited > 5.0f) {
+						v.done = true;
+						logger::info("Block collision test: no 3D  '{}'", v.label);
+					}
+				}
+			}
+			bool all = true;
+			for (const auto& v : variants) {
+				all = all && v.done;
+			}
+			if (!all) {
+				return;
+			}
+			variantsDone = true;
+			if (variantsSafe) {
+				logger::info("Block collision test: finished (models with no collision in them only; see which of them loaded above)");
+				EndVariants();
+				return;
+			}
+			int first = -1;
+			for (std::size_t i = 0; i < variants.size(); ++i) {
+				if (variants[i].ok && variants[i].usable) {
+					first = static_cast<int>(i);
+					break;
+				}
+			}
+			if (first < 0) {
+				logger::warn("Block collision test: Skyrim loaded none of the {} real-model variants (see the TEST lines above for what it does load); {} is the file as written (NifSkope will say what is wrong with it)", variants.size(), AbsolutePath(kDir.parent_path() / "debug_default.nif"));
+			} else if (variants[static_cast<std::size_t>(first)].label == "as written") {
+				logger::info("Block collision test: the model as written loads; the section models should too");
+			} else {
+				activeOpts = variants[first].opts;
+				logger::info("Block collision test: using '{}' for the section models from now on", variants[first].label);
+				failures = 0;
+				DropMeshes();  // the ones made as written are made again
+			}
+			EndVariants();
+		}
+	}
+
+	namespace BlockCollision
+	{
+		// Reads shape_catalog.json (written by the Fabric side: ShapeCatalog.java) and writes a model for every shape in it. A catalogue whose
+		// keys don't match the ones computed here (the two sides disagree on ShapeCatalog.canonical) is not used at all.
+		void PrepareLibrary()
+		{
+			const auto& cfg = Cfg();
+			libraryKeys.clear();
+			if (!cfg.library || cfg.maxShapeRefs <= 0) {
+				return;
+			}
+			std::vector<std::filesystem::path> candidates;
+			if (!cfg.catalog.empty()) {
+				candidates.emplace_back(cfg.catalog);
+			} else {
+				if (const char* local = std::getenv("LOCALAPPDATA")) {
+					candidates.push_back(std::filesystem::path(local) / "SkyCraft" / "Prism" / "instances" / "SkyCraft" / ".minecraft" / "skycraft" / "shape_catalog.json");
+				}
+				candidates.emplace_back("Data/SKSE/Plugins/SkyCraft/shape_catalog.json");
+			}
+			std::string text;
+			std::filesystem::path used;
+			for (const auto& c : candidates) {
+				std::ifstream in(c, std::ios::binary);
+				if (in) {
+					text.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+					used = c;
+					break;
+				}
+			}
+			if (text.empty()) {
+				logger::info("Block collision: no shape catalogue yet ({} places tried); Minecraft writes it the first time its world starts, and the shape library is made from it at the next start. Odd shapes are in the section models until then", candidates.size());
+				return;
+			}
+			std::error_code ec;
+			std::filesystem::create_directories(kLibDir, ec);
+			const float                    u = float(proto::kUnitsPerBlock);
+			std::unordered_set<std::string> keys;
+			std::size_t                    pos = 0;
+			int                            bad = 0;
+			while ((pos = text.find("\"key\": \"", pos)) != std::string::npos) {
+				pos += 8;
+				const std::string key = text.substr(pos, 8);
+				const auto        at = text.find("\"boxes\": [", pos);
+				if (at == std::string::npos) {
+					break;
+				}
+				std::size_t    i = at + 10;
+				int            depth = 1;
+				std::vector<int> nums;
+				while (i < text.size() && depth > 0) {
+					const char c = text[i];
+					if (c == '[') {
+						++depth;
+					} else if (c == ']') {
+						--depth;
+					} else if ((c >= '0' && c <= '9') || c == '-') {
+						char* end = nullptr;
+						nums.push_back(static_cast<int>(std::strtol(text.c_str() + i, &end, 10)));
+						i = static_cast<std::size_t>(end - text.c_str());
+						continue;
+					}
+					++i;
+				}
+				pos = i;
+				if (nums.empty() || nums.size() % 6 != 0) {
+					++bad;
+					continue;
+				}
+				std::vector<ShapeBox16>         q;
+				std::vector<collisionnif::Box>  boxes;
+				for (std::size_t n = 0; n < nums.size(); n += 6) {
+					ShapeBox16 b{};
+					for (int k = 0; k < 6; ++k) {
+						b.v[k] = nums[n + k];
+					}
+					q.push_back(b);
+				}
+				if (ShapeKey(q) != key) {
+					++bad;
+					continue;
+				}
+				for (const auto& b : q) {  // Minecraft (x, y up, z) in sixteenths -> the model's axes (x, y north = -z, z up), game units
+					collisionnif::Box box;
+					box.lo[0] = b.v[0] * u / 16.0f;
+					box.hi[0] = b.v[3] * u / 16.0f;
+					box.lo[1] = -b.v[5] * u / 16.0f;
+					box.hi[1] = -b.v[2] * u / 16.0f;
+					box.lo[2] = b.v[1] * u / 16.0f;
+					box.hi[2] = b.v[4] * u / 16.0f;
+					boxes.push_back(box);
+				}
+				const auto           bytes = collisionnif::Build(boxes, Cfg().material, 0.01f);
+				std::ofstream        out(kLibDir / ("shp_" + key + ".nif"), std::ios::binary | std::ios::trunc);
+				out.write(reinterpret_cast<const char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+				if (out.good()) {
+					keys.insert(key);
+				}
+			}
+			if (bad > 0 && keys.empty()) {
+				logger::warn("Block collision: shape catalogue {} isn't usable ({} entries whose keys or boxes don't match this plugin's); the library is off", used.string(), bad);
+				return;
+			}
+			libraryKeys = std::move(keys);
+			logger::info("Block collision: shape library: {} models in {} from {} ({} entries skipped); used once a section model has been seen working", libraryKeys.size(), AbsolutePath(kLibDir), used.string(), bad);
+		}
+
+		void PrepareFiles()
+		{
+			if (!Cfg().on) {
+				return;
+			}
+			const auto started = std::chrono::steady_clock::now();
+			std::error_code ec;
+			std::filesystem::remove_all(kDir, ec);  // models left by an earlier session
+			std::filesystem::create_directories(kDir, ec);
+			if (ec || !std::filesystem::is_directory(kDir)) {
+				logger::warn("Block collision: can't make the folder {}", kDir.string());
+				return;
+			}
+			using O = collisionnif::Options;
+			const float                          u = float(proto::kUnitsPerBlock);
+			const std::vector<collisionnif::Box> one{ collisionnif::Box{ { 0.0f, 0.0f, 0.0f }, { u, u, u } } };
+			O                                    bare, box;
+			bare.level = 0;
+			box.level = 2;
+			const auto placeholder = collisionnif::Build(one, Cfg().material, 0.01f, bare);
+			int        written = 0;
+			for (int i = 0; i < kSlots; ++i) {
+				written += WriteFile(fmt::format("slot{:04d}.nif", i), placeholder) ? 1 : 0;
+			}
+			written += WriteFile("pre_bare.nif", placeholder) ? 1 : 0;
+			written += WriteFile("pre_box.nif", collisionnif::Build(one, Cfg().material, 0.01f, box)) ? 1 : 0;
+			written += WriteFile("pre_full.nif", collisionnif::Build(one, Cfg().material, 0.01f, O{})) ? 1 : 0;
+			PrepareLibrary();
+			logger::info("Block collision: made {} model files in {} at plugin load ({} ms)", written, AbsolutePath(kDir),
+				std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - started).count());
+		}
+
+		bool Wanted()
+		{
+			return Cfg().on && !failed;
+		}
+
+		bool Verified()
+		{
+			return inWorldCount > 0;
+		}
+
+		bool NeedCrates()
+		{
+			return !Verified() || Cfg().cratesAlso;
+		}
+
+		void Release()
+		{
+			EndProbe();
+			EndVariants();
+			DropMeshes();
+			cellKey = 0;
+		}
+
+		void Update(RE::PlayerCharacter* a_player, float a_delta)
+		{
+			const auto& cfg = Cfg();
+			if (!cfg.on || failed || !a_player || !a_player->GetParentCell()) {
+				return;
+			}
+
+			static bool started = false;
+			if (!started) {
+				started = true;
+				std::error_code ec;
+				std::filesystem::create_directories(kDir, ec);  // (the files in it were made by PrepareFiles at plugin load)
+				slotNext = 0;
+				if (ec || !std::filesystem::is_directory(kDir)) {
+					GiveUp("can't make the folder Data/Meshes/SkyCraft/BlockCollision");
+					return;
+				}
+				serial = static_cast<std::uint32_t>(std::time(nullptr)) & 0xFFFFFF;
+				if (!std::filesystem::exists(kDir / "slot0000.nif")) {
+					logger::warn("Block collision: the model files weren't made at plugin load; the models will probably not load");
+				}
+				logger::info("Block collision: on, {} sections out ({} blocks), up to {} section meshes", cfg.radius, cfg.radius * 16, cfg.maxMeshes);
+			}
+
+			// Another cell or world: nothing made for the last one is any use here.
+			const auto key = CellKeyOf(a_player);
+			if (key != cellKey) {
+				Release();
+				cellKey = key;
+			}
+
+			// Meshes made a moment ago: has Skyrim loaded them, and is their collision in the Havok world?
+			for (auto it = meshes.begin(); it != meshes.end();) {
+				auto& mesh = it->second;
+				if (!mesh.pending) {
+					++it;
+					continue;
+				}
+				mesh.waited += a_delta;
+				auto* ref = RE::TESForm::LookupByID<RE::TESObjectREFR>(mesh.refId);
+				auto* root = ref ? ref->Get3D() : nullptr;
+				if (ref && !root && !mesh.forced && mesh.waited > 1.5f) {
+					mesh.forced = true;
+					root = ref->Load3D(false);
+					logger::info("Block collision: section ({}, {}, {}) had no 3D after {:.1f} s; asked Skyrim to load it: {}", mesh.sx, mesh.sy, mesh.sz, mesh.waited,
+						root ? "it did" : "still nothing");
+				}
+				bool failed3d = false;
+				if (root) {
+					mesh.settled += a_delta;
+					bool hasObject = false, inWorld = false;
+					CollisionState(root, hasObject, inWorld);
+					if (hasObject && inWorld) {
+						mesh.pending = false;
+						++inWorldCount;
+						static int logged = 0;
+						if (logged++ < 6) {
+							logger::info("Block collision: section ({}, {}, {}) works: {} boxes, collision in the Havok world ({}; reference made {})", mesh.sx, mesh.sy, mesh.sz, mesh.boxes, mesh.file,
+								mesh.atPlayer ? "at the player and moved" : "where it goes");
+						}
+						if (mesh.oldRefId != 0 || !mesh.oldFile.empty()) {
+							// Every swap is logged (a door opening or closing is one): this is the moment the old collision, door and all, goes.
+							logger::info("Block collision: section ({}, {}, {}) changed: the new model ({}, {} boxes) is in the Havok world {:.1f} s after it was made; the old one is put away", mesh.sx, mesh.sy, mesh.sz,
+								mesh.file, mesh.boxes, mesh.waited);
+							PutAway(mesh.oldRefId, mesh.oldFile);
+							mesh.oldRefId = 0;
+							mesh.oldFile.clear();
+						}
+					} else if (mesh.settled > 4.0f) {
+						failed3d = true;
+						logger::warn("Block collision: section ({}, {}, {}) loaded ({}) but {}", mesh.sx, mesh.sy, mesh.sz, mesh.file,
+							hasObject ? "its collision object never got a body into the Havok world" : "there is NO collision object in it");
+					}
+				} else if (mesh.waited > 8.0f) {
+					failed3d = true;
+					logger::warn("Block collision: section ({}, {}, {}) has no 3D after {:.0f} s ({}); reference {:08X} {}, in {}, model '{}'", mesh.sx, mesh.sy, mesh.sz, mesh.waited, mesh.file,
+						mesh.refId, ref ? (ref->IsDisabled() ? "is disabled" : "is enabled") : "is gone", ref && ref->GetParentCell() ? (ref->GetParentCell()->IsAttached() ? "an attached cell" : "a cell that isn't attached") : "no cell",
+						mesh.file);
+				}
+				if (failed3d) {
+					++failures;
+					PutAway(mesh.refId, mesh.file);  // the next pass makes it again, until it has failed three times
+					PutAway(mesh.oldRefId, mesh.oldFile);
+					it = meshes.erase(it);
+					if (failures >= 3 && inWorldCount == 0) {
+						GiveUp("the section models never got collision into the Havok world");
+						return;
+					}
+				} else {
+					++it;
+				}
+			}
+
+			TickVariants(a_delta);
+
+			if (probe.refId != 0 && !probe.done) {
+				probe.waited += a_delta;
+				auto* probeRef = RE::TESForm::LookupByID<RE::TESObjectREFR>(probe.refId);
+				if (probeRef && probeRef->Get3D()) {
+					probe.done = true;
+					logger::info("Block collision probe: a vanilla model loaded through a runtime-made static form in {:.1f} s, so such forms work; if the section models don't, Skyrim is rejecting SkyCraft's .nif files", probe.waited);
+					EndProbe();
+				} else if (probe.waited > 8.0f) {
+					probe.done = true;
+					logger::warn("Block collision probe: a vanilla model did NOT load through a runtime-made static form either, so the cause is the form or the reference (not the .nif files)");
+					EndProbe();
+				}
+			}
+
+			if (!cfg.experimental) {
+				// Collision models are off until their layout is right (a wrong one crashed Skyrim): the crates hold the player up, and what
+				// can be learnt without risk is done here: a copy of some vanilla models, and a few models with no collision in them.
+				DumpVanillaModels(a_player);
+				if (!variantsStarted) {
+					variantsSafe = true;
+					if (auto* handler = RE::TESDataHandler::GetSingleton()) {
+						StartVariants(a_player, handler, a_player->GetPosition(), cfg.material);
+					}
+				}
+				return;
+			}
+
+			sincePass += a_delta;
+			if (sincePass < 0.25f) {
+				return;
+			}
+			sincePass = 0.0f;
+
+			const auto sky = a_player->GetPosition();
+			const auto mc = SkyToMc(sky);
+			const int  psx = static_cast<int>(std::floor(mc.x / 16.0)), psy = static_cast<int>(std::floor(mc.y / 16.0)), psz = static_cast<int>(std::floor(mc.z / 16.0));
+
+			std::vector<NpcBlocks::SectionStamp> sections;
+			NpcBlocks::ListSections(sections);
+			std::unordered_map<std::uint64_t, const NpcBlocks::SectionStamp*> present;
+			for (const auto& s : sections) {
+				present[Key(s.sx, s.sy, s.sz)] = &s;
+			}
+
+			// Meshes whose section has no blocks now, whose reference's cell has gone, or that are well out of range: put away.
+			for (auto it = meshes.begin(); it != meshes.end();) {
+				const auto& mesh = it->second;
+				const bool  gone = !present.contains(it->first);
+				const bool  outOfRange = std::abs(mesh.sx - psx) > cfg.radius + 1 || std::abs(mesh.sz - psz) > cfg.radius + 1 || std::abs(mesh.sy - psy) > 4;
+				if (gone || outOfRange || (!mesh.pending && !Alive(mesh))) {
+					PutAway(mesh.refId, mesh.file);
+					PutAway(mesh.oldRefId, mesh.oldFile);
+					it = meshes.erase(it);
+				} else {
+					++it;
+				}
+			}
+
+			// Sections that need a model (none yet, or built from blocks that have changed), nearest first.
+			struct Todo
+			{
+				const NpcBlocks::SectionStamp* section;
+				int                            dist;
+			};
+			std::vector<Todo> todo;
+			for (const auto& s : sections) {
+				const int dx = std::abs(s.sx - psx), dz = std::abs(s.sz - psz), dy = std::abs(s.sy - psy);
+				if (dx > cfg.radius || dz > cfg.radius || dy > 3) {
+					continue;
+				}
+				const auto it = meshes.find(Key(s.sx, s.sy, s.sz));
+				if (it != meshes.end() && (it->second.stamp == s.stamp || it->second.pending)) {
+					continue;
+				}
+				todo.push_back({ &s, dx * dx + dz * dz + dy * dy });
+			}
+			std::ranges::sort(todo, {}, &Todo::dist);
+
+			// The library is used once a section model has been seen working (so the layout is proven) and only with the default layout, which
+			// is what the library files are written in. At that moment the sections already made are made again, so their odd shapes move over.
+			const bool useLib = cfg.library && !libBroken && !libraryKeys.empty() && Verified() && DefaultOptions(activeOpts);
+			if (useLib && !libWasOn) {
+				libWasOn = true;
+				for (auto& entry : meshes) {
+					entry.second.stamp = 0;
+				}
+				logger::info("Block collision: shape library on ({} shapes)", libraryKeys.size());
+			}
+			int libTotal = 0;
+			for (const auto& entry : libOf) {
+				libTotal += static_cast<int>(entry.second.size());
+			}
+			auto* handler = RE::TESDataHandler::GetSingleton();
+			int   made = 0;
+			for (const auto& t : todo) {
+				if (made >= 2) {
+					break;
+				}
+				const auto& s = *t.section;
+				const auto  mapKey = Key(s.sx, s.sy, s.sz);
+				if (meshes.size() >= static_cast<std::size_t>(cfg.maxMeshes) && !meshes.contains(mapKey)) {
+					continue;
+				}
+
+				std::vector<collisionnif::Box> boxes;
+				std::vector<LibBlock> lib;
+				BuildBoxes(s.sx, s.sy, s.sz, cfg.overlap, boxes, useLib ? &lib : nullptr, useLib ? std::min(96, cfg.maxShapeRefs - libTotal) : 0);
+				if (boxes.empty() && !lib.empty()) {
+					lib.clear();  // only odd shapes in this section: a section model of their boxes is simpler than a reference for each
+					BuildBoxes(s.sx, s.sy, s.sz, cfg.overlap, boxes);
+				}
+				logger::info("Block collision: rebuilding ({}, {}, {}) from stamp {}: {} boxes, {} library blocks", s.sx, s.sy, s.sz, s.stamp, boxes.size(), lib.size());
+				if (boxes.empty()) {
+					// Nothing solid after all: any old mesh goes.
+					if (auto it = meshes.find(mapKey); it != meshes.end()) {
+						PutAway(it->second.refId, it->second.file);
+						PutAway(it->second.oldRefId, it->second.oldFile);
+						meshes.erase(it);
+					}
+					continue;
+				}
+				if (boxes.size() > collisionnif::kMaxBoxes) {
+					logger::warn("Block collision: section ({}, {}, {}) has {} boxes; only the first {} get collision", s.sx, s.sy, s.sz, boxes.size(), collisionnif::kMaxBoxes);
+				}
+
+				const auto bytes = collisionnif::Build(boxes, cfg.material, 0.01f, activeOpts);
+				static bool dumped = false;
+				if (!dumped) {
+					dumped = true;  // kept for looking at in NifSkope if Skyrim won't load it
+					std::ofstream dump(kDir.parent_path() / "debug_default.nif", std::ios::binary | std::ios::trunc);
+					dump.write(reinterpret_cast<const char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+				}
+				const auto file = TakeSlot();
+				if (file.empty()) {
+					GiveUp("all the model files made at plugin load are used up (restart the game to get more)");
+					return;
+				}
+				if (!WriteFile(file, bytes)) {
+					GiveUp("can't write a section model into Data/Meshes/SkyCraft/BlockCollision");
+					return;
+				}
+
+				static bool checkedVisible = false;
+				if (!checkedVisible) {
+					checkedVisible = true;
+					RE::BSResourceNiBinaryStream stream(std::string("Meshes\\") + kModelDir + file);
+					logger::info("Block collision: can Skyrim's own file system open the first model (Meshes\\{}{}): {}", kModelDir, file, stream.good() ? "yes" : "NO");
+				}
+
+				auto* form = MakeStatic(std::string(kModelDir) + file, float(16 * proto::kUnitsPerBlock));
+				if (!form) {
+					GiveUp("can't make a form for a section model");
+					return;
+				}
+				const RE::NiPoint3 pos = McToSky(double(s.sx) * 16.0, double(s.sy) * 16.0, double(s.sz) * 16.0);
+				// Two ways to put a reference in the world, tried by turns if the first doesn't give a model that loads: made right where it goes, or
+				// made at the player (as the crates are) and moved.
+				const bool                       placeAtPlayer = (failures & 1) != 0;
+				RE::NiPointer<RE::TESObjectREFR> ref;
+				if (placeAtPlayer) {
+					ref = a_player->PlaceObjectAtMe(form, false);
+					if (ref) {
+						ref->SetPosition(pos);
+					}
+				} else {
+					ref = handler->CreateReferenceAtLocation(form, pos, RE::NiPoint3(), a_player->GetParentCell(), a_player->GetWorldspace(), nullptr, nullptr, RE::ObjectRefHandle(), false, true).get();
+				}
+				if (!ref) {
+					GiveUp("can't place a section model");
+					return;
+				}
+				ref->SetActivationBlocked(true);
+				++made;
+
+				// The odd shapes that come from the library: a reference to the model of each, at the block's low corner. They go (and are put
+				// away) with the section's reference. If one can't be made the library is given up and the section is made again without it.
+				bool libFailed = false;
+				if (!lib.empty()) {
+					auto& made_ids = libOf[ref->GetFormID()];
+					for (const auto& block : lib) {
+						auto* shapeForm = LibForm(block.key);
+						const RE::NiPoint3 at = McToSky(double(block.cell[0]), double(block.cell[1]), double(block.cell[2]));
+						RE::NiPointer<RE::TESObjectREFR> shapeRef;
+						if (shapeForm) {
+							shapeRef = handler->CreateReferenceAtLocation(shapeForm, at, RE::NiPoint3(), a_player->GetParentCell(), a_player->GetWorldspace(), nullptr, nullptr, RE::ObjectRefHandle(), false, true).get();
+						}
+						if (!shapeRef) {
+							libFailed = true;
+							break;
+						}
+						shapeRef->SetActivationBlocked(true);
+						made_ids.push_back(shapeRef->GetFormID());
+					}
+					if (libFailed) {
+						libBroken = true;
+						logger::warn("Block collision: can't place a shape library model; the library is given up and the odd shapes are in the section models again");
+					}
+				}
+
+				if (!variantsStarted) {
+					StartVariants(a_player, handler, pos, cfg.material);
+				}
+				if (!probe.done && probe.refId == 0) {
+					auto* crateForm = RE::TESForm::LookupByID(0x0007A617);
+					auto* crateModel = crateForm ? skyrim_cast<RE::TESModel*>(crateForm) : nullptr;
+					const char* vanillaPath = crateModel ? crateModel->GetModel() : nullptr;
+					if (vanillaPath && *vanillaPath) {
+						if (auto* probeForm = MakeStatic(vanillaPath, float(16 * proto::kUnitsPerBlock))) {
+							auto probeRef = handler->CreateReferenceAtLocation(probeForm, pos, RE::NiPoint3(), a_player->GetParentCell(), a_player->GetWorldspace(), nullptr, nullptr, RE::ObjectRefHandle(), false, true).get();
+							if (probeRef) {
+								probeRef->SetActivationBlocked(true);
+								probe.refId = probeRef->GetFormID();
+								logger::info("Block collision probe: put the vanilla model '{}' in the world through a runtime-made static form", vanillaPath);
+							}
+						}
+					}
+					if (probe.refId == 0) {
+						probe.done = true;
+					}
+				}
+
+				Mesh fresh;
+				fresh.sx = s.sx;
+				fresh.sy = s.sy;
+				fresh.sz = s.sz;
+				fresh.stamp = s.stamp;
+				fresh.refId = ref->GetFormID();
+				fresh.file = file;
+				fresh.boxes = static_cast<std::uint32_t>(std::min<std::size_t>(boxes.size(), collisionnif::kMaxBoxes));
+				fresh.pending = true;
+				fresh.atPlayer = placeAtPlayer;
+				if (auto it = meshes.find(mapKey); it != meshes.end()) {
+					fresh.oldRefId = it->second.refId;  // stays until this one has loaded
+					fresh.oldFile = it->second.file;
+					if (it->second.oldRefId != 0 || !it->second.oldFile.empty()) {
+						PutAway(it->second.oldRefId, it->second.oldFile);
+					}
+					it->second = std::move(fresh);
+				} else {
+					meshes.emplace(mapKey, std::move(fresh));
+				}
+				if (libFailed) {
+					meshes[mapKey].stamp = 0;  // made again, without the library, next pass
+				}
+			}
+		}
+	}
+}
diff --git a/skse/src/BlockCrates.cpp b/skse/src/BlockCrates.cpp
new file mode 100644
index 0000000..89ce05e
--- /dev/null
+++ b/skse/src/BlockCrates.cpp
@@ -0,0 +1,433 @@
+#include "Game.h"
+
+#include <SimpleIni.h>
+
+#include <filesystem>
+#include <fstream>
+
+// Skyrim's own physics knows nothing of Minecraft's blocks: the player's Havok body only gets a few fake support planes
+// (DigPhysics.cpp), so it never sees ground under it. It is put in the air state on every step, which is the slipping, and a
+// jump asked for in that state is ignored. This gives Havok the real thing: real, invisible crates (a base form from
+// SkyCraft.ini [Crates]), each scaled to one Minecraft block and set on the top of every solid block around the player that has
+// a face showing. Skyrim then stands the player on them, rubs against them and jumps off them as it does with any crate in the
+// game. They are only there while Skyrim's controls are on (Release() puts them all away), and are recycled as the player moves.
+namespace skycraft
+{
+	namespace BlockCrates
+	{
+		void Update(RE::PlayerCharacter* a_player, float a_delta);
+		void Release();
+	}
+
+	namespace
+	{
+		struct CrateCfg
+		{
+			bool        on{ true };
+			RE::FormID  base{ 0x0007A617 };
+			int         range{ 5 };
+			float       overlap{ 0.05f };  // how much wider than a block (a fraction) so neighbouring crates overlap and leave no seam
+			float       sink{ 0.0f };      // blocks to set the crates' tops below the block's top
+		};
+
+		const CrateCfg& CratesCfg()
+		{
+			static const CrateCfg settings = [] {
+				CSimpleIniA ini;
+				ini.SetUnicode();
+				ini.LoadFile("Data/SKSE/Plugins/SkyCraft.ini");
+				CrateCfg s;
+				s.on = ini.GetBoolValue("Crates", "bBlockCrates", true);
+				s.base = static_cast<RE::FormID>(std::strtoul(ini.GetValue("Crates", "sBaseForm", "0x0007A617"), nullptr, 0));
+				s.range = static_cast<int>(std::clamp<long>(ini.GetLongValue("Crates", "iRange", 5), 1, 8));
+				s.overlap = static_cast<float>(std::clamp(ini.GetDoubleValue("Crates", "fOverlap", 0.05), 0.0, 0.3));
+				s.sink = static_cast<float>(std::clamp(ini.GetDoubleValue("Crates", "fSink", 0.0), -0.2, 0.2));
+				return s;
+			}();
+			return settings;
+		}
+
+		struct Crate
+		{
+			RE::FormID    id{ 0 };
+			std::uint64_t key{ 0 };
+			int           x{ 0 }, y{ 0 }, z{ 0 };  // the block it stands on
+			bool          used{ false };    // standing on a block now (else it waits to be recycled)
+			bool          hidden{ false };  // its geometry has been hidden
+		};
+
+		std::vector<Crate> crates;
+		bool               failed = false;  // no usable base form: nothing is tried again
+		float              sincePass = 1.0f;
+		float              emptyFor = 0.0f;  // seconds with no block around (a section being sent again looks like that for a moment)
+
+		constexpr std::size_t kMaxCrates = 450;
+		constexpr int         kMaxMadePerPass = 20;
+		const char*           kStaleFile = "Data/SKSE/Plugins/SkyCraft-crates.txt";
+
+		std::uint64_t BlockKey(int a_x, int a_y, int a_z)
+		{
+			return (std::uint64_t(std::uint32_t(a_x) & 0x3FFFFF) << 42) | (std::uint64_t(std::uint32_t(a_z) & 0x3FFFFF) << 20) | (std::uint64_t(std::uint32_t(a_y) & 0xFFFFF));
+		}
+
+		// The base form's own bounds (what its model measures), if this CommonLib can read them.
+		template <class B>
+		bool BoundsOf(B* a_base, float& a_width, float& a_depth, float& a_height, float& a_centreX, float& a_centreY, float& a_top)
+		{
+			if constexpr (requires { a_base->boundData.boundMin.x; a_base->boundData.boundMax.x; }) {
+				const auto& lo = a_base->boundData.boundMin;
+				const auto& hi = a_base->boundData.boundMax;
+				a_width = float(hi.x) - float(lo.x);
+				a_depth = float(hi.y) - float(lo.y);
+				a_height = float(hi.z) - float(lo.z);
+				a_centreX = (float(hi.x) + float(lo.x)) * 0.5f;
+				a_centreY = (float(hi.y) + float(lo.y)) * 0.5f;
+				a_top = float(hi.z);
+				return a_width > 1.0f && a_depth > 1.0f && a_height > 1.0f;
+			} else {
+				return false;
+			}
+		}
+
+		template <class R>
+		void SetRefScale(R* a_ref, float a_scale)
+		{
+			if constexpr (requires { a_ref->refScale = std::uint16_t(100); }) {
+				a_ref->refScale = static_cast<std::uint16_t>(std::clamp<long>(std::lround(a_scale * 100.0f), 1, 1000));
+			} else if constexpr (requires { a_ref->SetScale(a_scale); }) {
+				a_ref->SetScale(a_scale);
+			}
+		}
+
+		template <class R>
+		void PlaceRef(R* a_ref, const RE::NiPoint3& a_pos)
+		{
+			if constexpr (requires { a_ref->SetPosition(a_pos, true); }) {
+				a_ref->SetPosition(a_pos, true);
+			} else if constexpr (requires { a_ref->SetPosition(a_pos); }) {
+				a_ref->SetPosition(a_pos);
+			}
+		}
+
+		template <class R>
+		void DeleteRef(R* a_ref)
+		{
+			if (!a_ref) {
+				return;
+			}
+			// Never delete an actor: a stored ID can outlive its reference (Skyrim frees our references when a cell unloads or a save loads,
+			// then reuses the ID), and deleting what it now names, a stand-in actor, crashes the engine's movement code.
+			if constexpr (requires { a_ref->template As<RE::Actor>(); }) {
+				if (a_ref->template As<RE::Actor>()) {
+					return;
+				}
+			}
+			if constexpr (requires { a_ref->Disable(); }) {
+				a_ref->Disable();
+			}
+			if constexpr (requires { a_ref->SetDelete(true); }) {
+				a_ref->SetDelete(true);
+			}
+		}
+
+		template <class P, class B>
+		RE::TESObjectREFR* SpawnRef(P* a_player, B* a_base)
+		{
+			if constexpr (requires { a_player->PlaceObjectAtMe(a_base, false); }) {
+				auto ref = a_player->PlaceObjectAtMe(a_base, false);
+				return ref ? ref.get() : nullptr;
+			} else {
+				return nullptr;
+			}
+		}
+
+		template <class R>
+		void BlockActivation(R* a_ref)
+		{
+			if constexpr (requires { a_ref->SetActivationBlocked(true); }) {
+				a_ref->SetActivationBlocked(true);
+			}
+		}
+
+		// Hides the crate's geometry and nothing else: its collision stays. (Once its 3D has loaded, a moment after it is made.)
+		template <class R>
+		bool HideGeometry(R* a_ref, float a_wantScale)
+		{
+			auto* root = a_ref->Get3D();
+			if (!root) {
+				return false;
+			}
+			int hidden = 0;
+			if constexpr (requires { root->AsNode(); root->AsGeometry(); root->AsNode()->GetChildren(); root->SetAppCulled(true); }) {
+				std::vector<RE::NiAVObject*> stack{ root };
+				for (std::size_t visited = 0; !stack.empty() && visited < 512; ++visited) {
+					auto* object = stack.back();
+					stack.pop_back();
+					if (!object) {
+						continue;
+					}
+					if (object->AsGeometry()) {
+						object->SetAppCulled(true);
+						++hidden;
+					} else if (auto* node = object->AsNode()) {
+						for (auto& child : node->GetChildren()) {
+							if (child) {
+								stack.push_back(child.get());
+							}
+						}
+					}
+				}
+			}
+			static int logged = 0;
+			if (logged++ < 3) {
+				float have = 0.0f;
+				if constexpr (requires { root->local.scale; }) {
+					have = float(root->local.scale);
+				}
+				logger::info("Block crate ({:08X}): hid {} geometry nodes; its 3D has scale {:.3f} (wanted {:.3f})", a_ref->GetFormID(), hidden, have, a_wantScale);
+			}
+			return true;
+		}
+
+		void WriteStaleFile()
+		{
+			std::ofstream out(kStaleFile, std::ios::trunc);
+			for (const auto& crate : crates) {
+				out << std::hex << crate.id << '\n';
+			}
+		}
+
+		// A crate left in a save (a crash, or a save made while they were out) is put away the next time the plugin starts.
+		void PutAwayStale(RE::FormID a_base)
+		{
+			std::ifstream in(kStaleFile);
+			std::string   line;
+			int           gone = 0;
+			while (std::getline(in, line)) {
+				const auto id = static_cast<RE::FormID>(std::strtoul(line.c_str(), nullptr, 16));
+				if (id == 0) {
+					continue;
+				}
+				auto* ref = RE::TESForm::LookupByID<RE::TESObjectREFR>(id);
+				if (ref && ref->GetBaseObject() && ref->GetBaseObject()->GetFormID() == a_base) {
+					DeleteRef(ref);
+					++gone;
+				}
+			}
+			in.close();
+			std::ofstream(kStaleFile, std::ios::trunc);
+			if (gone > 0) {
+				logger::info("Block crates: put away {} crates left over from an earlier session", gone);
+			}
+		}
+
+		bool FullCube(std::int32_t a_x, std::int32_t a_y, std::int32_t a_z)
+		{
+			NpcBlocks::BlockBox boxes[NpcBlocks::kMaxBoxes];
+			const int           n = NpcBlocks::BoxesAt(a_x, a_y, a_z, boxes);
+			if (n != 1) {
+				return false;
+			}
+			const auto& b = boxes[0];
+			return b.lo[0] < 0.01f && b.lo[1] < 0.01f && b.lo[2] < 0.01f && b.hi[0] > 0.99f && b.hi[1] > 0.99f && b.hi[2] > 0.99f;
+		}
+
+		bool Exposed(int a_x, int a_y, int a_z)
+		{
+			return !NpcBlocks::SolidAt(a_x, a_y + 1, a_z) || !NpcBlocks::SolidAt(a_x, a_y - 1, a_z) || !NpcBlocks::SolidAt(a_x + 1, a_y, a_z) ||
+			       !NpcBlocks::SolidAt(a_x - 1, a_y, a_z) || !NpcBlocks::SolidAt(a_x, a_y, a_z + 1) || !NpcBlocks::SolidAt(a_x, a_y, a_z - 1);
+		}
+
+		struct Want
+		{
+			int           x, y, z;
+			std::uint64_t key;
+			float         dist;
+		};
+	}
+
+	namespace BlockCrates
+	{
+		RE::FormID BaseForm()
+		{
+			return CratesCfg().base;
+		}
+
+		void Release()
+		{
+			if (crates.empty()) {
+				return;
+			}
+			for (const auto& crate : crates) {
+				if (auto* ref = RE::TESForm::LookupByID<RE::TESObjectREFR>(crate.id)) {
+					DeleteRef(ref);
+				}
+			}
+			logger::info("Block crates: put away {} crates", crates.size());
+			crates.clear();
+			std::ofstream(kStaleFile, std::ios::trunc);
+			sincePass = 1.0f;
+		}
+
+		void Update(RE::PlayerCharacter* a_player, float a_delta)
+		{
+			const auto& cfg = CratesCfg();
+			if (!cfg.on || failed || !a_player || !a_player->GetParentCell()) {
+				return;
+			}
+			static bool started = false;
+			static RE::TESBoundObject* base = nullptr;
+			static float scale = 1.0f, centreX = 0.0f, centreY = 0.0f, top = 0.0f;
+			if (!started) {
+				started = true;
+				auto* form = RE::TESForm::LookupByID(cfg.base);
+				base = form ? form->As<RE::TESBoundObject>() : nullptr;
+				if (!base) {
+					failed = true;
+					logger::warn("Block crates: form {:08X} (SkyCraft.ini [Crates] sBaseForm) isn't an object that can be placed; no crates", cfg.base);
+					return;
+				}
+				PutAwayStale(cfg.base);
+				float w = 0, d = 0, h = 0;
+				if (BoundsOf(base, w, d, h, centreX, centreY, top)) {
+					// One uniform scale (a reference can't be scaled any other way): its narrower side is a block plus a little, so neighbours overlap and leave no seam; its top is set at the block's top.
+					scale = static_cast<float>(proto::kUnitsPerBlock) * (1.0f + cfg.overlap) / std::min(w, d);
+					logger::info("Block crates: '{}' ({:08X}, form type {}) is {:.1f} x {:.1f} x {:.1f} units; scaled by {:.3f} it is {:.2f} x {:.2f} x {:.2f} blocks",
+						base->GetName(), base->GetFormID(), int(base->GetFormType()), w, d, h, scale, w * scale / proto::kUnitsPerBlock, d * scale / proto::kUnitsPerBlock,
+						h * scale / proto::kUnitsPerBlock);
+				} else {
+					logger::warn("Block crates: can't read the size of form {:08X} in this build; its crates are placed unscaled", base->GetFormID());
+				}
+			}
+			if (!base) {
+				return;
+			}
+
+			// Crates made a moment ago: their geometry is hidden as soon as their 3D has loaded.
+			for (auto& crate : crates) {
+				if (!crate.hidden) {
+					if (auto* ref = RE::TESForm::LookupByID<RE::TESObjectREFR>(crate.id)) {
+						crate.hidden = HideGeometry(ref, scale);
+					}
+				}
+			}
+
+			sincePass += a_delta;
+			if (sincePass < 0.1f) {
+				return;
+			}
+			sincePass = 0.0f;
+
+			const auto sky = a_player->GetPosition();
+			const auto mc = SkyToMc(sky);
+			const int  px = int(std::floor(mc.x)), py = int(std::floor(mc.y)), pz = int(std::floor(mc.z));
+			const int  r = cfg.range;
+
+			std::vector<Want> wanted;
+			for (int z = pz - r; z <= pz + r; ++z) {
+				for (int x = px - r; x <= px + r; ++x) {
+					for (int y = py - 2; y <= py + 2; ++y) {
+						if (!NpcBlocks::SolidAt(x, y, z) || !FullCube(x, y, z) || !Exposed(x, y, z)) {
+							continue;
+						}
+						const float dx = float(x) + 0.5f - float(mc.x), dy = float(y) + 0.5f - float(mc.y), dz = float(z) + 0.5f - float(mc.z);
+						wanted.push_back({ x, y, z, BlockKey(x, y, z), dx * dx + dy * dy + dz * dz });
+					}
+				}
+			}
+			std::ranges::sort(wanted, {}, &Want::dist);
+			if (wanted.size() > kMaxCrates) {
+				wanted.resize(kMaxCrates);
+			}
+
+			// No block around at all: a section being sent again looks like that for a moment, and every crate must not go with it.
+			if (wanted.empty()) {
+				emptyFor += 0.1f;
+				if (emptyFor < 1.0f) {
+					return;
+				}
+			} else {
+				emptyFor = 0.0f;
+			}
+
+			// Crates that left the cell the player is in (a door, fast travel) can't be moved to it, and crates whose block has gone (dug,
+			// or no longer a whole cube) would be a wall nobody can see: both are put away. Crates for blocks that are still there but
+			// out of range stay where they are (they are still real ground) until one is needed for a nearer block.
+			bool changed = false;
+			for (auto& crate : crates) {
+				auto* ref = RE::TESForm::LookupByID<RE::TESObjectREFR>(crate.id);
+				if (!ref || ref->GetParentCell() != a_player->GetParentCell() || !FullCube(crate.x, crate.y, crate.z)) {
+					DeleteRef(ref);
+					crate.id = 0;
+					changed = true;
+				}
+			}
+			std::erase_if(crates, [](const Crate& a_crate) { return a_crate.id == 0; });
+
+			std::unordered_set<std::uint64_t> wantedKeys;
+			for (const auto& w : wanted) {
+				wantedKeys.insert(w.key);
+			}
+			std::unordered_set<std::uint64_t> have;
+			for (auto& crate : crates) {
+				// (A crate out of range keeps its block's key and coordinates: it stays, and is still checked above, until a nearer block needs it.)
+				crate.used = wantedKeys.contains(crate.key);
+				if (crate.used) {
+					have.insert(crate.key);
+				}
+			}
+
+			std::size_t slot = 0;
+			int         made = 0;
+			for (const auto& w : wanted) {
+				if (have.contains(w.key)) {
+					continue;
+				}
+				// A crate no nearby block needs, or a new one.
+				while (slot < crates.size() && crates[slot].used) {
+					++slot;
+				}
+				Crate*             crate = nullptr;
+				RE::TESObjectREFR* ref = nullptr;
+				if (made < kMaxMadePerPass && crates.size() < kMaxCrates) {
+					// New ones first while there is room: a crate left standing on a block out of range is still ground, so it is not taken.
+					ref = SpawnRef(a_player, base);
+					if (!ref) {
+						failed = true;
+						logger::warn("Block crates: couldn't place a crate (this CommonLib has no PlaceObjectAtMe); no crates");
+						return;
+					}
+					++made;
+					SetRefScale(ref, scale);
+					BlockActivation(ref);
+					crates.push_back({ ref->GetFormID() });
+					crate = &crates.back();
+				} else if (slot < crates.size()) {
+					crate = &crates[slot];
+					ref = RE::TESForm::LookupByID<RE::TESObjectREFR>(crate->id);
+				}
+				if (!crate || !ref) {
+					continue;
+				}
+				RE::NiPoint3 pos = McToSky(double(w.x) + 0.5, double(w.y) + 1.0 - double(cfg.sink), double(w.z) + 0.5);
+				pos.x -= centreX * scale;
+				pos.y -= centreY * scale;
+				pos.z -= top * scale;
+				PlaceRef(ref, pos);
+				crate->key = w.key;
+				crate->x = w.x;
+				crate->y = w.y;
+				crate->z = w.z;
+				crate->used = true;
+				changed = true;
+			}
+			if (changed) {
+				WriteStaleFile();
+				static int logged = 0;
+				if (logged++ < 5) {
+					logger::info("Block crates: {} crates for {} blocks around the player", crates.size(), wanted.size());
+				}
+			}
+		}
+	}
+}
diff --git a/skse/src/CollisionNif.h b/skse/src/CollisionNif.h
new file mode 100644
index 0000000..48dc1e3
--- /dev/null
+++ b/skse/src/CollisionNif.h
@@ -0,0 +1,392 @@
+#pragma once
+
+// Writes a Skyrim SE .nif that holds nothing but collision: an invisible static (BSFadeNode) with a fixed rigid body whose shape is a list
+// of boxes. BlockCollision.cpp makes one of these for every section of Minecraft's blocks, Skyrim loads it as the model of a static
+// reference, and its own loader turns the collision objects into Havok bodies in the cell's world, as it does for any building or rock.
+//
+// No Skyrim or CommonLib code in here: just bytes, so it can be (and was) checked on its own against an independent NIF reader.
+//
+// Layout (version 20.2.0.7, user version 12, user version 2 100), blocks in this order (children before the blocks that refer to them, as Skyrim's own files):
+//   0 BSFadeNode (the root)   1 BSXFlags (havok)   2.. bhkConvexVerticesShape (one per box)   then bhkListShape, bhkRigidBody, bhkCollisionObject
+// A box is a convex-vertices shape rather than a bhkBoxShape because a list's children can't be moved without a transform shape, and a
+// box with its own corners needs none.
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace skycraft::collisionnif
+{
+	struct Box
+	{
+		float lo[3];  // corners, in game units from the model's origin (Skyrim's axes: x east, y north, z up)
+		float hi[3];
+	};
+
+	// One Havok unit is this many game units.
+	inline constexpr float kHavokScale = 69.99124f;
+
+	inline constexpr std::uint32_t kMaxBoxes = 4000;
+
+	// Details of the file that Skyrim might be particular about; BlockCollision.cpp tries variants of these side by side and keeps the first
+	// that Skyrim loads (the defaults are the layout written from the NIF format's description).
+	struct Options
+	{
+		bool          plainNode{ false };      // the root is a NiNode, not a BSFadeNode
+		bool          rigidBodyT{ false };     // the body's type is named bhkRigidBodyT (same fields; most of Skyrim's static bodies are)
+		std::uint16_t collisionFlags{ 129 };     // bhkCollisionObject flags (Skyrim's own often have 129)
+		std::uint32_t bsxFlags{ 130 };         // BSXFlags value (0x82 as on vanilla statics: havok + static)
+		int           preambleExtra{ 0 };      // bytes more (or fewer) in the body before its translation
+		int           tailExtra{ 0 };          // bytes more (or fewer) in the body after its flags and before its constraints
+		std::uint8_t  layer{ 1 };              // Havok collision layer of the body: 1 static, 8 biped (what Skyrim's weapons, arrows and spells hit on an actor)
+		std::uint8_t  motion{ 5 };             // motion system: 5 fixed, 6 keyframed (follows its node, as an actor's bones do)
+		bool          actorNodes{ false };     // an actor skeleton: the root is "NPC Root [Root]" with "NPC COM [COM ]" and "NPC Head [Head]" under it
+		float         headHeight{ 0.0f };      // game units above the feet for the head node (actorNodes)
+		int           level{ 3 };              // 0: a bare node, 1: with BSXFlags, 2: with a body whose shape is one box, 3: the real thing (a list of boxes)
+	};
+
+	// Havok material of the whole shape (the hash of its name). 3741512247 is stone: its footsteps, its sounds, its impacts.
+	inline constexpr std::uint32_t kMaterialStone = 3741512247u;
+
+	namespace detail
+	{
+		class Out
+		{
+		public:
+			std::vector<std::uint8_t> bytes;
+
+			template <class T>
+			void Put(T a_value)
+			{
+				const auto at = bytes.size();
+				bytes.resize(at + sizeof(T));
+				std::memcpy(bytes.data() + at, &a_value, sizeof(T));
+			}
+
+			void Zeros(std::size_t a_count) { bytes.resize(bytes.size() + a_count, 0); }
+
+			void Text(const std::string& a_text) { bytes.insert(bytes.end(), a_text.begin(), a_text.end()); }
+		};
+
+		// hkWorldObjCInfoProperty: the array header Havok keeps in the file (data pointer, size, capacity | "don't free")
+		inline void Property(Out& a_out, std::uint32_t a_size)
+		{
+			a_out.Put<std::uint32_t>(0);
+			a_out.Put<std::uint32_t>(a_size);
+			a_out.Put<std::uint32_t>(0x80000000u | a_size);
+		}
+
+		// HavokFilter: layer (1 = static), flags and part number, group
+		inline void Filter(Out& a_out, std::uint8_t a_layer = 1)
+		{
+			a_out.Put<std::uint8_t>(a_layer);
+			a_out.Put<std::uint8_t>(0);
+			a_out.Put<std::uint16_t>(0);
+		}
+
+		inline void Vec4(Out& a_out, float a_x, float a_y, float a_z, float a_w)
+		{
+			a_out.Put(a_x);
+			a_out.Put(a_y);
+			a_out.Put(a_z);
+			a_out.Put(a_w);
+		}
+
+		// the bhkRigidBody block: fixed in place (a static), its shape the block a_shapeRef
+		inline void RigidBody(Out& b, std::int32_t a_shapeRef, const Options& a_opt)
+		{
+			b.Put<std::int32_t>(a_shapeRef);  // shape
+			Filter(b, a_opt.layer);
+			b.Put<std::uint32_t>(0);  // (unused)
+			b.Put<std::uint8_t>(1);   // broad phase: entity
+			b.Zeros(3);
+			Property(b, 0);
+			b.Put<std::uint8_t>(1);       // collision response: simple contact
+			b.Put<std::uint8_t>(0);
+			b.Put<std::uint16_t>(0xFFFF); // process contact callback delay
+			b.Put<std::uint32_t>(0);
+			Filter(b, a_opt.layer);       // filter copy
+			// Revision 35: these twelve bytes were all zeros. In every one of Skyrim's own bodies (58 checked in vanilla_dump) the last four are
+			// 01 xx FF FF: the SECOND collision response and callback delay, the pair Havok really builds the body from. Zero there is response
+			// type INVALID, which has no contact handler, and the first thing to touch the body (the player's controller standing in the section)
+			// calls through it.
+			b.Zeros(static_cast<std::size_t>(8 + a_opt.preambleExtra));
+			b.Put<std::uint8_t>(1);       // collision response 2: simple contact
+			b.Put<std::uint8_t>(0);
+			b.Put<std::uint16_t>(0xFFFF); // process contact callback delay 2
+			Vec4(b, 0, 0, 0, 0);          // translation
+			Vec4(b, 0, 0, 0, 1);          // rotation (x y z w)
+			Vec4(b, 0, 0, 0, 0);          // linear velocity
+			Vec4(b, 0, 0, 0, 0);          // angular velocity
+			b.Zeros(48);                  // inertia tensor
+			Vec4(b, 0, 0, 0, 0);          // centre
+			b.Put(0.0f);                  // mass (0: fixed)
+			b.Put(0.1f);                  // linear damping
+			b.Put(0.05f);                 // angular damping
+			b.Put(1.0f);                  // time factor
+			b.Put(1.0f);                  // gravity factor
+			b.Put(0.5f);                  // friction
+			b.Put(0.0f);                  // rolling friction multiplier (0 in every vanilla body; 1.0 was written before)
+			b.Put(0.4f);                  // restitution
+			b.Put(104.4f);                // max linear velocity
+			b.Put(31.57f);                // max angular velocity
+			b.Put(0.15f);                 // penetration depth
+			// These eight bytes copied from Skyrim's own static bodies (vanilla_dump: 05 01 01 00 00 00 03 00). Motion system 5 is FIXED;
+			// the 7 written here before is CHARACTER, which made Skyrim treat the static as a character-controller body.
+			b.Put<std::uint8_t>(a_opt.motion);  // motion system: 5 fixed, 6 keyframed
+			b.Put<std::uint8_t>(1);       // deactivator: never
+			b.Put<std::uint8_t>(1);       // solver deactivation: off
+			b.Put<std::uint8_t>(0);       // quality (0 in every vanilla static)
+			b.Put<std::uint8_t>(0);       // auto remove level
+			b.Put<std::uint8_t>(0);       // response modifier
+			b.Put<std::uint8_t>(3);       // as vanilla
+			b.Put<std::uint8_t>(0);       // force collided owner
+			b.Zeros(static_cast<std::size_t>(12 + a_opt.tailExtra));
+			b.Put<std::uint32_t>(0);      // constraints
+			b.Put<std::uint16_t>(0);      // body flags
+		}
+
+		// Header, blocks and footer of a file whose blocks are given (the layout of the header is the same whatever is in the blocks).
+		inline std::vector<std::uint8_t> Assemble(const std::vector<Out>& a_blocks, const std::vector<std::string>& a_typeNames, const std::vector<std::uint16_t>& a_typeOf, const std::vector<std::string>& a_strings)
+		{
+			Out file;
+			file.Text("Gamebryo File Format, Version 20.2.0.7\n");
+			file.Put<std::uint32_t>(0x14020007);
+			file.Put<std::uint8_t>(1);   // little endian
+			file.Put<std::uint32_t>(12); // user version
+			file.Put<std::uint32_t>(static_cast<std::uint32_t>(a_blocks.size()));
+			file.Put<std::uint32_t>(100);  // user version 2 (Skyrim SE)
+			for (const char* text : { "SkyCraft", "", "" }) {
+				const std::size_t n = std::strlen(text);
+				file.Put<std::uint8_t>(static_cast<std::uint8_t>(n + 1));
+				file.Text(text);
+				file.Put<std::uint8_t>(0);
+			}
+			file.Put<std::uint16_t>(static_cast<std::uint16_t>(a_typeNames.size()));
+			for (const auto& name : a_typeNames) {
+				file.Put<std::uint32_t>(static_cast<std::uint32_t>(name.size()));
+				file.Text(name);
+			}
+			for (const auto t : a_typeOf) {
+				file.Put<std::uint16_t>(t);
+			}
+			for (const auto& b : a_blocks) {
+				file.Put<std::uint32_t>(static_cast<std::uint32_t>(b.bytes.size()));
+			}
+			std::uint32_t longest = 0;
+			for (const auto& str : a_strings) {
+				longest = std::max<std::uint32_t>(longest, static_cast<std::uint32_t>(str.size()));
+			}
+			file.Put<std::uint32_t>(static_cast<std::uint32_t>(a_strings.size()));
+			file.Put<std::uint32_t>(longest);
+			for (const auto& str : a_strings) {
+				file.Put<std::uint32_t>(static_cast<std::uint32_t>(str.size()));
+				file.Text(str);
+			}
+			file.Put<std::uint32_t>(0);  // groups
+			for (const auto& b : a_blocks) {
+				file.bytes.insert(file.bytes.end(), b.bytes.begin(), b.bytes.end());
+			}
+			file.Put<std::uint32_t>(1);  // roots
+			file.Put<std::int32_t>(0);
+			return std::move(file.bytes);
+		}
+
+		// The root node: its extra data (a_extra, -1 for none) and collision object (a_collision, -1 for none).
+		inline void RootNode(Out& b, std::int32_t a_extra, std::int32_t a_collision, std::int32_t a_name = 0, float a_z = 0.0f, const std::vector<std::int32_t>& a_children = {})
+		{
+			b.Put<std::int32_t>(a_name);  // name: a string index
+			if (a_extra >= 0) {
+				b.Put<std::uint32_t>(1);
+				b.Put<std::int32_t>(a_extra);
+			} else {
+				b.Put<std::uint32_t>(0);
+			}
+			b.Put<std::int32_t>(-1);  // no controller
+			b.Put<std::uint32_t>(14); // flags
+			b.Put(0.0f), b.Put(0.0f), b.Put(a_z);
+			const float identity[9] = { 1, 0, 0, 0, 1, 0, 0, 0, 1 };
+			for (const float f : identity) {
+				b.Put(f);
+			}
+			b.Put(1.0f);
+			b.Put<std::int32_t>(a_collision);
+			b.Put<std::uint32_t>(static_cast<std::uint32_t>(a_children.size()));  // children
+			for (const auto c : a_children) {
+				b.Put<std::int32_t>(c);
+			}
+			b.Put<std::uint32_t>(0);  // effects
+		}
+
+		// Smaller files for finding out which part Skyrim won't load: 0 a bare node, 1 plus BSXFlags, 2 plus a body of one box (a bhkBoxShape).
+		inline std::vector<std::uint8_t> Simple(const Box& a_box, std::uint32_t a_material, float a_radius, const Options& a_opt, float a_scale)
+		{
+			const std::string nodeType = a_opt.plainNode ? "NiNode" : "BSFadeNode";
+			std::vector<Out>           blocks;
+			std::vector<std::string>   types{ nodeType };
+			std::vector<std::uint16_t> typeOf{ 0 };
+			std::vector<std::string>   strings{ "SkyCraftCollision" };
+			blocks.resize(1);
+			if (a_opt.level <= 0) {
+				RootNode(blocks[0], -1, -1);
+				return Assemble(blocks, types, typeOf, strings);
+			}
+			strings.push_back("BSX");
+			types.push_back("BSXFlags");
+			typeOf.push_back(1);
+			blocks.resize(2);
+			blocks[1].Put<std::int32_t>(1);
+			blocks[1].Put<std::uint32_t>(a_opt.bsxFlags);
+			if (a_opt.level == 1) {
+				RootNode(blocks[0], 1, -1);
+				return Assemble(blocks, types, typeOf, strings);
+			}
+			// Revision 35: blocks in Skyrim's own order, a shape before the body that holds it and the body before the collision object (the
+			// loader builds each Havok object as it links its block, so a block must come after everything it refers to).
+			RootNode(blocks[0], 1, 4);
+			types.push_back("bhkBoxShape");
+			types.push_back(a_opt.rigidBodyT ? "bhkRigidBodyT" : "bhkRigidBody");
+			types.push_back("bhkCollisionObject");
+			typeOf.push_back(2);
+			typeOf.push_back(3);
+			typeOf.push_back(4);
+			blocks.resize(5);
+			{
+				Out& b = blocks[2];  // the box
+				b.Put<std::uint32_t>(a_material);
+				b.Put(a_radius);
+				b.Zeros(8);
+				b.Put((a_box.hi[0] - a_box.lo[0]) * 0.5f / a_scale);  // half extents
+				b.Put((a_box.hi[1] - a_box.lo[1]) * 0.5f / a_scale);
+				b.Put((a_box.hi[2] - a_box.lo[2]) * 0.5f / a_scale);
+				b.Put(0.0f);
+			}
+			RigidBody(blocks[3], 2, a_opt);
+			blocks[4].Put<std::int32_t>(0);
+			blocks[4].Put<std::uint16_t>(a_opt.collisionFlags);
+			blocks[4].Put<std::int32_t>(3);
+			return Assemble(blocks, types, typeOf, strings);
+		}
+
+	}
+
+	// The file's bytes. a_radius is Havok's convex radius in Havok units (0.01 is what Skyrim's own meshes use); boxes beyond kMaxBoxes are dropped.
+	//
+	// Block order (revision 35; this is Skyrim's own order, checked on every list shape in vanilla_dump): 0 root, 1 BSXFlags, 2.. the convex
+	// shapes (one per box), then the list shape, the rigid body and the collision object. Skyrim builds each Havok object while linking its
+	// block, in file order, so a list shape placed BEFORE its children read their (still null) Havok shapes: the crash at SkyrimSE.exe+0EEE90F,
+	// `mov r8d, [rdx+0x18]` with rdx 0 (a shape's type), in the model loader thread, on every section model.
+	inline std::vector<std::uint8_t> Build(const std::vector<Box>& a_boxes, std::uint32_t a_material = kMaterialStone, float a_radius = 0.01f, const Options& a_opt = {})
+	{
+		using namespace detail;
+
+		if (a_opt.level < 3) {
+			const Box first = a_boxes.empty() ? Box{ { 0, 0, 0 }, { 70, 70, 70 } } : a_boxes[0];
+			return Simple(first, a_material, a_radius, a_opt, kHavokScale);
+		}
+
+		const std::uint32_t boxCount = static_cast<std::uint32_t>(a_boxes.size() > kMaxBoxes ? kMaxBoxes : a_boxes.size());
+		const std::uint32_t extraNodes  = a_opt.actorNodes ? 2u : 0u;  // "NPC COM [COM ]" and "NPC Head [Head]", after the collision object
+		const std::uint32_t blockCount  = 5 + boxCount + extraNodes;
+		const std::int32_t  listAt = static_cast<std::int32_t>(2 + boxCount);
+		const std::int32_t  bodyAt = listAt + 1;
+		const std::int32_t  collisionAt = listAt + 2;
+
+		std::vector<Out> blocks(blockCount);
+
+		// 0: the root (a BSFadeNode with nothing in it but the collision)
+		if (a_opt.actorNodes) {
+			RootNode(blocks[0], 1, collisionAt, 0, 0.0f, { collisionAt + 1, collisionAt + 2 });
+			float com = 0.0f, top = 0.0f;
+			for (std::uint32_t i = 0; i < boxCount; ++i) {
+				top = std::max(top, a_boxes[i].hi[2]);
+			}
+			com = top * 0.5f;
+			const float head = a_opt.headHeight > 0.0f ? a_opt.headHeight : top * 0.9f;
+			RootNode(blocks[static_cast<std::size_t>(collisionAt + 1)], -1, -1, 2, com);
+			RootNode(blocks[static_cast<std::size_t>(collisionAt + 2)], -1, -1, 3, head);
+		} else {
+			RootNode(blocks[0], 1, collisionAt);
+		}
+
+		// 1: BSXFlags: havok (bit 1), so the loader makes the collision
+		{
+			Out& b = blocks[1];
+			b.Put<std::int32_t>(1);  // name: string 1 ("BSX")
+			b.Put<std::uint32_t>(a_opt.bsxFlags);
+		}
+
+		// 2..: one bhkConvexVerticesShape per box: its 8 corners and 6 planes (normal, then -distance: inside is where n.p + d <= 0)
+		for (std::uint32_t i = 0; i < boxCount; ++i) {
+			Out&  b = blocks[2 + i];
+			float lo[3], hi[3];
+			for (int k = 0; k < 3; ++k) {
+				lo[k] = a_boxes[i].lo[k] / kHavokScale;
+				hi[k] = a_boxes[i].hi[k] / kHavokScale;
+			}
+			b.Put<std::uint32_t>(a_material);
+			b.Put(a_radius);
+			b.Zeros(24);  // both array headers empty, as vanilla's convex shapes have them
+			b.Put<std::uint32_t>(8);
+			for (int corner = 0; corner < 8; ++corner) {
+				Vec4(b, (corner & 1) ? hi[0] : lo[0], (corner & 2) ? hi[1] : lo[1], (corner & 4) ? hi[2] : lo[2], 0.0f);
+			}
+			b.Put<std::uint32_t>(6);
+			Vec4(b, 1, 0, 0, -hi[0]);
+			Vec4(b, -1, 0, 0, lo[0]);
+			Vec4(b, 0, 1, 0, -hi[1]);
+			Vec4(b, 0, -1, 0, lo[1]);
+			Vec4(b, 0, 0, 1, -hi[2]);
+			Vec4(b, 0, 0, -1, lo[2]);
+		}
+
+		// the list shape
+		{
+			Out& b = blocks[static_cast<std::size_t>(listAt)];
+			b.Put<std::uint32_t>(boxCount);
+			for (std::uint32_t i = 0; i < boxCount; ++i) {
+				b.Put<std::int32_t>(static_cast<std::int32_t>(2 + i));
+			}
+			b.Put<std::uint32_t>(a_material);
+			// The two array headers are written empty (all zeros, as in vanilla's BasicTankard01).
+			b.Zeros(12);  // child shapes
+			b.Zeros(12);  // child filters
+			b.Put<std::uint32_t>(boxCount);
+			for (std::uint32_t i = 0; i < boxCount; ++i) {
+				Filter(b);
+			}
+		}
+
+		// the rigid body
+		RigidBody(blocks[static_cast<std::size_t>(bodyAt)], listAt, a_opt);
+
+		// the collision object
+		{
+			Out& b = blocks[static_cast<std::size_t>(collisionAt)];
+			b.Put<std::int32_t>(0);   // target: the root
+			b.Put<std::uint16_t>(a_opt.collisionFlags);  // flags (1: active)
+			b.Put<std::int32_t>(bodyAt);
+		}
+
+		// ---- the header, the blocks and the footer ----
+		std::vector<std::string>   typeNames{ a_opt.plainNode ? "NiNode" : "BSFadeNode", "BSXFlags", "bhkConvexVerticesShape", "bhkListShape", a_opt.rigidBodyT ? "bhkRigidBodyT" : "bhkRigidBody", "bhkCollisionObject" };
+		std::vector<std::uint16_t> typeOf(blockCount);
+		typeOf[0] = 0;
+		typeOf[1] = 1;
+		for (std::uint32_t i = 0; i < boxCount; ++i) {
+			typeOf[2 + i] = 2;
+		}
+		typeOf[static_cast<std::size_t>(listAt)] = 3;
+		typeOf[static_cast<std::size_t>(bodyAt)] = 4;
+		typeOf[static_cast<std::size_t>(collisionAt)] = 5;
+		if (a_opt.actorNodes) {
+			typeNames.push_back("NiNode");
+			typeOf[static_cast<std::size_t>(collisionAt + 1)] = 6;
+			typeOf[static_cast<std::size_t>(collisionAt + 2)] = 6;
+			return Assemble(blocks, typeNames, typeOf, { "NPC Root [Root]", "BSX", "NPC COM [COM ]", "NPC Head [Head]" });
+		}
+		return Assemble(blocks, typeNames, typeOf, { "SkyCraftCollision", "BSX" });
+	}
+}
